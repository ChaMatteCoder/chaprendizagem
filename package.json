{
  "name": "chaprendizagem-maquina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src/features/iadivinha src/app/App.jsx src/pages/HomePage.jsx src/components/ProjectCard.jsx --max-warnings 0",
    "dev": "vite --host 127.0.0.1 --clearScreen false",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test": "node --test tests/*.test.js",
    "test:kmeans": "node --test tests/kmeans.test.js",
    "test:newsletter": "node --test tests/newsletter.test.js",
    "newsletter:announce": "node --env-file-if-exists=.env scripts/announce-module.mjs",
    "train:digits": "python training/train_digits_mnist.py",
    "export:digits-weights": "python training/export_digits_weights_json.py",
    "train:alphanumeric": "python training/train_alphanumeric_mnist_emnist.py",
    "export:alphanumeric-weights": "python training/export_alphanumeric_weights_json.py"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "resend": "^6.16.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0"
  }
}
