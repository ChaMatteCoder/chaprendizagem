{
  "name": "chaprendizagem-maquina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src/features/enganai src/features/iadivinha src/features/sonar src/features/pixel src/features/convolution training/sonar training/pixel tests/enganai-*.test.js tests/sonar-*.test.js tests/pixel-*.test.js tests/convolution.test.js scripts/check-enganai-browser.mjs scripts/check-enganai-inference-browser.mjs scripts/check-enganai-mission-browser.mjs scripts/check-convolution-browser.mjs scripts/check-pixel-browser.mjs src/app/App.jsx src/pages/HomePage.jsx src/components/ProjectCard.jsx --max-warnings 0",
    "dev": "vite --host 127.0.0.1 --clearScreen false",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test": "node --test tests/*.test.js",
    "test:kmeans": "node --test tests/kmeans.test.js",
    "test:newsletter": "node --test tests/newsletter.test.js",
    "test:sonar": "node --test tests/sonar-*.test.js",
    "test:pixel": "node --test tests/pixel-*.test.js",
    "test:pixel:browser": "node scripts/check-pixel-browser.mjs",
    "test:convolution": "node --test tests/convolution.test.js",
    "test:convolution:browser": "node scripts/check-convolution-browser.mjs",
    "test:enganai": "node --test tests/enganai-*.test.js",
    "test:enganai:browser": "node scripts/check-enganai-browser.mjs",
    "prepare:enganai": "training/enganai/.venv/bin/python training/enganai/data.py --download",
    "check:enganai": "training/enganai/.venv/bin/python training/enganai/data.py --check",
    "test:enganai:training": "training/enganai/.venv/bin/python -m unittest discover -s training/enganai -p 'test_*.py' -v",
    "train:enganai:smoke": "training/enganai/.venv/bin/python training/enganai/train.py --smoke",
    "train:enganai": "training/enganai/.venv/bin/python training/enganai/train.py",
    "verify:enganai": "training/enganai/.venv/bin/python training/enganai/verify.py public/models/enganai/research/cpu-no-batchnorm-v1",
    "report:enganai": "training/enganai/.venv/bin/python training/enganai/report.py public/models/enganai/research/cpu-no-batchnorm-v1 --output docs/enganai/etapa-03",
    "prepare:sonar": "node training/sonar/prepare-data.mjs",
    "check:sonar": "node training/sonar/prepare-data.mjs --check",
    "train:sonar": "node training/sonar/run-experiment.mjs",
    "evaluate:sonar": "node training/sonar/evaluate-final.mjs",
    "verify:sonar": "node training/sonar/verify-official.mjs",
    "explain:sonar": "node training/sonar/explain-example.mjs",
    "prepare:pixel": "python3 training/pixel/prepare_cifar10.py --download",
    "check:pixel": "python3 training/pixel/prepare_cifar10.py --check",
    "train:pixel": "python3 training/pixel/train_cnn.py --publish",
    "verify:pixel": "node training/pixel/verify_official.mjs",
    "explain:pixel": "node training/pixel/explain_example.mjs",
    "newsletter:announce": "node --env-file-if-exists=.env scripts/announce-module.mjs",
    "train:digits": "python training/train_digits_mnist.py",
    "export:digits-weights": "python training/export_digits_weights_json.py",
    "train:alphanumeric": "python training/train_alphanumeric_mnist_emnist.py",
    "export:alphanumeric-weights": "python training/export_alphanumeric_weights_json.py",
    "test:enganai:inference-browser": "node scripts/check-enganai-inference-browser.mjs",
    "export:enganai:onnx": "training/enganai/.venv/bin/python training/enganai/export_onnx.py public/models/enganai/research/cpu-no-batchnorm-v1 --publish",
    "verify:enganai:onnx": "training/enganai/.venv/bin/python training/enganai/export_onnx.py public/models/enganai/research/cpu-no-batchnorm-v1 --check",
    "test:enganai:mission-browser": "node scripts/check-enganai-mission-browser.mjs",
    "prepare:enganai:arena": "training/enganai/.venv/bin/python training/enganai/arena_pool.py",
    "verify:enganai:arena": "training/enganai/.venv/bin/python training/enganai/arena_pool.py --check"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "onnxruntime-web": "1.31.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "resend": "^6.16.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0"
  }
}
