# Copie este arquivo para .env para desenvolvimento local.
# Nunca use o prefixo VITE_ em segredos: variáveis VITE_ chegam ao navegador.

# Resend
RESEND_API_KEY=re_substitua_por_sua_chave
RESEND_FROM_EMAIL="Chaprendizagem <novidades@updates.seudominio.com>"
RESEND_REPLY_TO=contato@seudominio.com
RESEND_NEWSLETTER_SEGMENT_ID=seg_substitua_pelo_id_do_segmento

# URL pública do site. Com `vercel dev`, normalmente é http://localhost:3000.
NEWSLETTER_SITE_URL=http://localhost:3000

# Gere dois valores longos e diferentes, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSLETTER_TOKEN_SECRET=substitua_por_um_segredo_longo_e_aleatorio
NEWSLETTER_ANNOUNCE_SECRET=substitua_por_outro_segredo_longo_e_aleatorio

# Segurança: false cria rascunhos; true permite que /api/newsletter/announce envie a campanha.
NEWSLETTER_SEND_ENABLED=false
